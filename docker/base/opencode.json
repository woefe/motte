        "claude-haiku-5-5": { "name": "Claude Haiku 5.5" },
        "minimax-m3": { "name": "MiniMax M3" },
        "minimax-m2.7": { "name": "MiniMax M2.7" },
        "mimo-v2.6-pro": { "name": "MiMo-V2.6-Pro" },
