{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":disableDependencyDashboard"
  ],
  "enabledManagers": [
    "github-actions",
    "gomod",
    "mise"
  ],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
